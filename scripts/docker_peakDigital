#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_DIR="${ROOT_DIR}/projects/peak-reviews-ai-ops"
ENV_FILE="${PROJECT_DIR}/.env"
ACTION="${1:-up}"
PLATFORM='unknown'
PLATFORM_NAME='Unknown'
ARCHITECTURE='unknown'
COMPOSE_STYLE='unknown'
PYTHON_BIN=''

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
YELLOW='\033[1;33m'
NC='\033[0m'

banner() {
  printf "${PURPLE}"
  printf '%s\n' '╔════════════════════════════════════════════════════════╗'
  printf '%s\n' '║  PEAK REVIEWS AI OPS                                  ║'
  printf '%s\n' '║  Laravel + Next.js + PostgreSQL + AI automation       ║'
  printf '%s\n' '╚════════════════════════════════════════════════════════╝'
  printf "${NC}"
}

die() {
  printf "${RED}Error:${NC} %s\n" "$1" >&2
  exit 1
}

detect_platform() {
  local kernel machine release_name
  kernel="$(uname -s 2>/dev/null || printf 'unknown')"
  machine="$(uname -m 2>/dev/null || printf 'unknown')"

  case "$kernel" in
    Darwin)
      PLATFORM='macos'
      release_name="$(sw_vers -productVersion 2>/dev/null || true)"
      PLATFORM_NAME="macOS${release_name:+ ${release_name}}"
      ;;
    Linux)
      if [ -r /proc/version ] && grep -qiE 'microsoft|wsl' /proc/version; then
        PLATFORM='wsl'
        PLATFORM_NAME='Windows (WSL)'
      else
        PLATFORM='linux'
        PLATFORM_NAME='Linux'
        if [ -r /etc/os-release ]; then
          # The standard os-release file contains shell-safe operating-system metadata.
          # shellcheck disable=SC1091
          . /etc/os-release
          PLATFORM_NAME="${PRETTY_NAME:-Linux}"
        fi
      fi
      ;;
    MINGW* | MSYS* | CYGWIN*)
      PLATFORM='windows'
      PLATFORM_NAME='Windows'
      ;;
    *)
      die "Unsupported operating system: ${kernel}. Use macOS, Linux, WSL or Windows with Git Bash."
      ;;
  esac

  case "$machine" in
    x86_64 | amd64) ARCHITECTURE='amd64' ;;
    arm64 | aarch64) ARCHITECTURE='arm64' ;;
    *) ARCHITECTURE="$machine" ;;
  esac

  if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN='python3'
  elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN='python'
  fi
}

show_platform() {
  printf "${CYAN}Platform:${NC} %s (%s)\n" "$PLATFORM_NAME" "$ARCHITECTURE"
}

compose() {
  [ "$COMPOSE_STYLE" != 'unknown' ] || detect_compose
  if [ "$COMPOSE_STYLE" = 'plugin' ]; then
    docker compose --project-directory "$PROJECT_DIR" --env-file "$ENV_FILE" "$@"
  else
    docker-compose --project-directory "$PROJECT_DIR" --env-file "$ENV_FILE" "$@"
  fi
}

detect_compose() {
  if docker compose version >/dev/null 2>&1; then
    COMPOSE_STYLE='plugin'
  elif command -v docker-compose >/dev/null 2>&1 && docker-compose version >/dev/null 2>&1; then
    COMPOSE_STYLE='standalone'
  else
    die 'Docker Compose is unavailable. Install the Docker Compose plugin and rerun this command.'
  fi
}

port_available() {
  local port="$1"

  if [ -n "$PYTHON_BIN" ]; then
    "$PYTHON_BIN" - "$port" <<'PY'
import socket
import sys

with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    try:
        sock.bind(("127.0.0.1", int(sys.argv[1])))
    except OSError:
        raise SystemExit(1)
PY
    return $?
  fi

  if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -Command \
      '& { param($port) try { $listener = [Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback, [int]$port); $listener.Start(); $listener.Stop(); exit 0 } catch { exit 1 } }' \
      "$port" >/dev/null 2>&1
    return $?
  fi

  if command -v lsof >/dev/null 2>&1; then
    ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
    return $?
  fi

  if command -v nc >/dev/null 2>&1; then
    ! nc -z 127.0.0.1 "$port" >/dev/null 2>&1
    return $?
  fi

  die 'Port detection requires Python, PowerShell, lsof or netcat.'
}

choose_port() {
  local port="$1"
  while ! port_available "$port"; do
    port=$((port + 1))
  done
  printf '%s' "$port"
}

random_hex() {
  local bytes="${1:-24}"
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$bytes"
  elif [ -n "$PYTHON_BIN" ]; then
    "$PYTHON_BIN" - "$bytes" <<'PY'
import secrets
import sys
print(secrets.token_hex(int(sys.argv[1])))
PY
  elif [ -r /dev/urandom ]; then
    od -An -N"$bytes" -tx1 /dev/urandom | tr -d ' \n'
  else
    die 'Secure secret generation requires OpenSSL, Python or /dev/urandom.'
  fi
}

random_base64_key() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 32 | tr -d '\r\n'
  elif [ -n "$PYTHON_BIN" ]; then
    "$PYTHON_BIN" <<'PY'
import base64
import secrets
print(base64.b64encode(secrets.token_bytes(32)).decode())
PY
  elif [ -r /dev/urandom ] && command -v base64 >/dev/null 2>&1; then
    dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64 | tr -d '\r\n'
  else
    die 'Secure application-key generation requires OpenSSL, Python or base64 with /dev/urandom.'
  fi
}

create_env() {
  [ -f "$ENV_FILE" ] && return 0

  local web_port api_port postgres_port app_key postgres_password
  web_port="$(choose_port 3000)"
  api_port="$(choose_port 8000)"
  postgres_port="$(choose_port 5433)"
  app_key="$(random_base64_key)"
  postgres_password="$(random_hex 18)"

  umask 077
  {
    printf 'WEB_PORT=%s\n' "$web_port"
    printf 'API_PORT=%s\n' "$api_port"
    printf 'POSTGRES_PORT=%s\n' "$postgres_port"
    printf 'POSTGRES_DB=peak_reviews\n'
    printf 'POSTGRES_USER=peak\n'
    printf 'POSTGRES_PASSWORD=%s\n' "$postgres_password"
    printf 'APP_KEY=base64:%s\n' "$app_key"
    printf 'OPENAI_API_KEY=%s\n' "${OPENAI_API_KEY:-}"
    printf 'OPENAI_MODEL=%s\n' "${OPENAI_MODEL:-gpt-4o-mini}"
  } >"$ENV_FILE"

  printf "${GREEN}Created${NC} local configuration with free ports and generated secrets.\n"
}

env_value() {
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

wait_for_url() {
  local name="$1"
  local url="$2"
  local attempts=90
  local count=1

  printf "${CYAN}Waiting${NC} for %s" "$name"
  while [ "$count" -le "$attempts" ]; do
    if curl --silent --fail --max-time 3 "$url" >/dev/null 2>&1; then
      printf " ${GREEN}ready${NC}\n"
      return 0
    fi
    printf '.'
    sleep 2
    count=$((count + 1))
  done

  printf " ${RED}failed${NC}\n"
  compose ps
  compose logs --tail=80 api frontend
  die "$name did not become ready at $url"
}

show_urls() {
  local web_port api_port
  web_port="$(env_value WEB_PORT)"
  api_port="$(env_value API_PORT)"
  printf "\n${GREEN}Peak Reviews AI Ops is ready.${NC}\n"
  printf '  Dashboard:  %s\n' "http://localhost:${web_port}"
  printf '  Laravel API: %s\n' "http://localhost:${api_port}/api/dashboard/summary"
  printf '  Health:      %s\n' "http://localhost:${api_port}/up"
  printf '\n%s\n' 'The demo works without an OpenAI key using its audited deterministic fallback.'
}

ensure_requirements() {
  if ! command -v docker >/dev/null 2>&1; then
    case "$PLATFORM" in
      macos) die 'Docker is not installed. Install Docker Desktop from https://docs.docker.com/desktop/setup/install/mac-install/' ;;
      windows | wsl) die 'Docker is not installed. Install Docker Desktop with WSL integration from https://docs.docker.com/desktop/setup/install/windows-install/' ;;
      linux) die 'Docker is not installed. Install Docker Engine and the Compose plugin from https://docs.docker.com/engine/install/' ;;
    esac
  fi

  detect_compose

  if ! docker info >/dev/null 2>&1; then
    start_docker_if_supported
  fi
  docker info >/dev/null 2>&1 || die "Docker is installed but not running on ${PLATFORM_NAME}. Start Docker and rerun this command."

  command -v curl >/dev/null 2>&1 || die "curl is required for readiness checks on ${PLATFORM_NAME}."
}

wait_for_docker() {
  local count=1
  printf "${CYAN}Waiting${NC} for Docker"
  while [ "$count" -le 120 ]; do
    if docker info >/dev/null 2>&1; then
      printf " ${GREEN}ready${NC}\n"
      return 0
    fi
    printf '.'
    sleep 1
    count=$((count + 1))
  done
  printf " ${RED}failed${NC}\n"
  return 1
}

start_docker_if_supported() {
  printf "${YELLOW}Docker is not running.${NC}\n"
  case "$PLATFORM" in
    macos)
      if command -v open >/dev/null 2>&1 && open -a Docker >/dev/null 2>&1; then
        printf 'Starting Docker Desktop for macOS...\n'
        wait_for_docker || true
      fi
      ;;
    windows | wsl)
      if command -v powershell.exe >/dev/null 2>&1 && powershell.exe -NoProfile -Command \
        '$docker = Join-Path $Env:ProgramFiles "Docker\Docker\Docker Desktop.exe"; if (Test-Path $docker) { Start-Process $docker; exit 0 }; exit 1' \
        >/dev/null 2>&1; then
        printf 'Starting Docker Desktop for Windows...\n'
        wait_for_docker || true
      fi
      ;;
    linux)
      printf '%s\n' 'Start Docker with: sudo systemctl start docker'
      ;;
  esac
}

open_browser() {
  local url="$1"
  [ "${OPEN_BROWSER:-1}" = '1' ] || return 0

  case "$PLATFORM" in
    macos)
      command -v open >/dev/null 2>&1 && open "$url" >/dev/null 2>&1 || true
      ;;
    linux)
      if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 || true
      elif command -v gio >/dev/null 2>&1; then
        gio open "$url" >/dev/null 2>&1 || true
      fi
      ;;
    windows | wsl)
      command -v cmd.exe >/dev/null 2>&1 && cmd.exe /c start "" "$url" >/dev/null 2>&1 || true
      ;;
  esac
}

run_up() {
  ensure_requirements
  create_env
  local web_port api_port
  web_port="$(env_value WEB_PORT)"
  api_port="$(env_value API_PORT)"

  printf "${CYAN}Building and starting${NC} the complete application...\n"
  if ! compose up --build --detach --remove-orphans; then
    printf "${RED}Startup failed.${NC} Recent service logs:\n" >&2
    compose ps --all || true
    compose logs --tail=100 postgres api frontend || true
    exit 1
  fi
  wait_for_url 'Laravel API' "http://localhost:${api_port}/api/dashboard/summary"
  wait_for_url 'Next.js dashboard' "http://localhost:${web_port}"
  show_urls

  open_browser "http://localhost:${web_port}"
}

detect_platform
banner
show_platform

case "$ACTION" in
  up | start)
    run_up
    ;;
  down | stop)
    create_env
    compose down
    ;;
  restart)
    create_env
    compose down
    run_up
    ;;
  status)
    create_env
    compose ps
    printf '  Dashboard:   http://localhost:%s\n' "$(env_value WEB_PORT)"
    printf '  Laravel API: http://localhost:%s/api/dashboard/summary\n' "$(env_value API_PORT)"
    ;;
  logs)
    create_env
    compose logs --follow --tail=120
    ;;
  test)
    ensure_requirements
    create_env
    compose up --build --detach postgres api frontend
    compose run --rm --no-deps \
      -e APP_ENV=testing \
      -e DB_CONNECTION=sqlite \
      -e DB_DATABASE=:memory: \
      -e CACHE_STORE=array \
      -e SESSION_DRIVER=array \
      -e QUEUE_CONNECTION=sync \
      api sh -lc 'cp .env.example .env && php artisan test'
    compose run --rm --no-deps frontend bun run lint
    ;;
  reset)
    ensure_requirements
    create_env
    printf "${YELLOW}Resetting${NC} containers and the local PostgreSQL volume...\n"
    compose down --volumes --remove-orphans
    run_up
    ;;
  *)
    printf 'Usage: scripts/docker_peakDigital [start|stop|restart|status|logs|test|reset]\n' >&2
    exit 2
    ;;
esac
